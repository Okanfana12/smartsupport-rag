cat > .gitignore << 'EOF'
# Environnement virtuel
.venv/

# Secrets — NE JAMAIS commiter
.env

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Données générées automatiquement
data/chroma_db/
data/faiss_index/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/
EOF